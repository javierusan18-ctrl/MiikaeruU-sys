# Plantilla para desarrollo local con `vercel dev` — copiar a `.env.local`
# (NUNCA se commitea, ver .gitignore) y completar con valores reales.
#
# Uso: desde miikaeru-web/
#   1. cp .env.example .env.local        (o `vercel env pull .env.local` si
#      SUPABASE_DB_URL ya está guardada en el proyecto de Vercel)
#   2. completar SUPABASE_DB_URL abajo
#   3. vercel dev

# Obligatoria para que /api/* funcione en local (login-account,
# register-account, admin-list-users, admin-reset-password, admin-metrics,
# admin-manage-admins, admin-verify, init-db). Sin esta variable, esos
# endpoints responden 500 "missing_env" — el resto de la app sigue andando
# igual (ver getSupabaseEnvDiagnostics() en api/_utils.js).
#
# Se obtiene UNA vez en Supabase → Settings → Database → Connection string
# → modo "Transaction pooler" (puerto 6543 — resuelve por IPv4, requisito
# de las Serverless Functions de Vercel; el modo "Direct connection",
# puerto 5432 / host db.<ref>.supabase.co, requiere IPv6 y falla acá).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-xxxxx.pooler.supabase.com:6543/postgres

# Ya están hardcodeadas en app.js y api/_utils.js — son valores PÚBLICOS
# (URL del proyecto + "publishable key" pensada para vivir en el navegador
# de cualquiera), no secretos. Se listan acá solo como referencia/registro,
# `vercel dev` no las lee de este archivo para que la app funcione.
SUPABASE_URL=https://pzurvgcurifdkhbfxhrv.supabase.co
SUPABASE_ANON_KEY=sb_publishable_NApj9xOyicARat8ummK52Q_mY20RsBz

# Opcional — solo hace falta si vas a probar el Asistente IA en local
# (api/ai-conversation.js). Sin esto, esa función responde error pero el
# resto de la app (incluido el Panel de Administrador) funciona normal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
