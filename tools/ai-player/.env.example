# Copiar este archivo a .env (NUNCA commitear .env con la clave real) y
# completar ANTHROPIC_API_KEY antes de correr `node player.js`.

# Tu propia clave de API de Anthropic (console.anthropic.com) — esta
# herramienta corre fuera de la sesión de Claude Code, necesita su propia
# credencial con facturación activa.
ANTHROPIC_API_KEY=sk-ant-...

# Mismos valores que ya están embebidos en miikaeru-web/app.js
# (initSupabaseClient()) — es la clave "publishable", pensada para vivir en
# código de cliente, NO un secreto. No hace falta cambiarla.
SUPABASE_URL=https://pzurvgcurifdkhbfxhrv.supabase.co
SUPABASE_KEY=sb_publishable_NApj9xOyicARat8ummK52Q_mY20RsBz

# URL del servidor de desarrollo local que la IA Jugador va a "jugar".
# config.js SE NIEGA A ARRANCAR si esto no es localhost/127.0.0.1 — ver
# el candado de seguridad ahí.
TARGET_URL=http://localhost:5500
